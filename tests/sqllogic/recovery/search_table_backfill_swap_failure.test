# A search-table CREATE INDEX whose rebuilt segment is gone by the time the
# build swaps it in fails with the reason, leaves the table as it was, and a
# second CREATE INDEX succeeds. Requires SDB_FAULT_INJECTION.

control substitution on

statement ok
RESET sdb_faults;


statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
CREATE TABLE bfs (id BIGINT PRIMARY KEY, tag TEXT)
  WITH (storage = 'search', refresh_interval = 0, compaction_interval = 0);


statement ok
INSERT INTO bfs VALUES (1, 'alpha'), (2, 'beta');

statement ok
VACUUM (REFRESH_TABLE) bfs;


statement ok
SET sdb_faults = 'IndexWriter::AdoptedMetaGone';


statement error
CREATE INDEX bfs_idx ON bfs USING inverted (tag);
----
db error: ERROR: search-table build: failed to swap in the rebuilt segments on table <slt:ignore>: cannot replace with segment meta '<slt:ignore>': it does not exist


statement ok
RESET sdb_faults;


query
SELECT indexname FROM pg_indexes WHERE tablename = 'bfs' ORDER BY indexname;
----
indexname
bfs_pkey


query
SELECT id, tag FROM bfs ORDER BY id;
----
id	tag
1	alpha
2	beta


statement ok
CREATE INDEX bfs_idx ON bfs USING inverted (tag);


query
SELECT id FROM bfs_idx WHERE tag @@ 'beta';
----
id
2
